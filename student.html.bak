<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Кабинет ученика | The Curator’s</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        body { min-height: 100vh; display: flex; flex-direction: column; }
        header { padding: 15px 5%; display: flex; justify-content: space-between; align-items: center; background: var(--card-bg); border-bottom: 1px solid rgba(244, 243, 238, 0.1); position: sticky; top: 0; z-index: 100; }
        .logo-container img { width: 150px; height: auto; }
        .header-right { display: flex; align-items: center; gap: 20px; }
        .header-right span { font-size: 0.9rem; opacity: 0.7; }
        .btn-logout { color: var(--accent-lime); text-decoration: none; font-weight: 600; font-size: 0.9rem; border: 1px solid var(--accent-lime); padding: 8px 15px; border-radius: 10px; transition: 0.3s; }
        .btn-logout:hover { background: var(--accent-lime); color: var(--bg-color); }

        .container { padding: 30px 5%; max-width: 1000px; margin: 0 auto; width: 100%; flex: 1; }
        
        /* Табы */
        .tabs-nav { display: flex; gap: 10px; margin-bottom: 30px; background: var(--card-bg); padding: 10px; border-radius: 15px; overflow-x: auto; }
        .tab-btn { background: transparent; border: none; color: var(--text-main); padding: 10px 20px; border-radius: 10px; font-size: 1rem; font-weight: 600; cursor: pointer; transition: 0.3s; white-space: nowrap; }
        .tab-btn:hover { background: rgba(255,255,255,0.05); }
        .tab-btn.active { background: var(--accent-lime); color: var(--bg-color); }
        
        .tab-content { display: none; animation: fadeIn 0.3s ease-in-out; }
        .tab-content.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .profile-header { background: linear-gradient(135deg, #313452 0%, #7455d9 100%); padding: 40px; border-radius: 30px; margin-bottom: 30px; display: flex; align-items: center; gap: 30px; box-shadow: 0 15px 40px rgba(0,0,0,0.2); }
        
        .avatar-container { position: relative; width: 120px; height: 120px; flex-shrink: 0; }
        .avatar-img { width: 100%; height: 100%; border-radius: 50%; background: var(--accent-lime); padding: 10px; box-shadow: 0 10px 20px rgba(0,0,0,0.3); }
        .avatar-edit-btn { position: absolute; bottom: 0; right: 0; background: var(--card-bg); border: 2px solid var(--accent-lime); color: var(--text-main); width: 35px; height: 35px; border-radius: 50%; cursor: pointer; display: flex; justify-content: center; align-items: center; font-size: 1rem; transition: 0.3s; }
        .avatar-edit-btn:hover { background: var(--accent-lime); color: var(--bg-color); }

        .profile-info h1 { font-size: 2rem; margin-bottom: 5px; }
        .profile-info p { opacity: 0.9; font-size: 1.1rem; margin-bottom: 10px; }
        .tags-container { display: flex; flex-wrap: wrap; gap: 8px; }
        .subject-tag { display: inline-block; background: rgba(255,255,255,0.2); padding: 5px 15px; border-radius: 20px; font-size: 0.9rem; backdrop-filter: blur(5px); }
        
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 25px; margin-bottom: 30px; }
        .info-card { background: var(--card-bg); padding: 30px; border-radius: 24px; border: 1px solid rgba(244, 243, 238, 0.05); }
        .info-card h3 { font-size: 1.1rem; margin-bottom: 20px; color: var(--accent-lime); }
        
        .level-bar-container { background: var(--bg-color); height: 20px; border-radius: 10px; overflow: hidden; margin-top: 10px; }
        .level-bar-fill { background: var(--accent-lime); height: 100%; border-radius: 10px; display: flex; align-items: center; justify-content: flex-end; padding-right: 10px; font-size: 0.8rem; font-weight: 800; color: var(--bg-color); transition: width 1s ease-in-out; }
        
        .calendar-student { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; background: var(--bg-color); padding: 15px; border-radius: 12px; margin-top: 15px; }
        .cal-header-st { font-weight: bold; text-align: center; font-size: 0.8rem; opacity: 0.5; margin-bottom: 5px; }
        .cal-day-st { padding: 8px 5px; text-align: center; border-radius: 8px; font-size: 0.9rem; border: 1px solid transparent; min-height: 50px; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; }
        .cal-day-st.lesson-day { background: var(--accent-lime); color: var(--bg-color); font-weight: bold; }
        .cal-time-st { font-size: 0.65rem; font-weight: normal; margin-top: 2px; opacity: 0.8; }
        .cal-month-title { font-size: 1.2rem; font-weight: 800; color: white; margin-bottom: 10px; }

        .custom-list { list-style: none; }
        .custom-list li { padding: 12px 0; border-bottom: 1px solid rgba(244, 243, 238, 0.1); display: flex; align-items: flex-start; gap: 10px; }
        .custom-list li:last-child { border-bottom: none; }
        .tests-list li::before { content: '📊'; }
        .topics-list li::before { content: '✓'; color: var(--accent-lime); font-weight: 800; }
        .iom-list li::before { content: '→'; color: var(--accent-purple); font-weight: 800; }
        
        .highlight-card { background: var(--card-bg); padding: 30px; border-radius: 24px; border-left: 4px solid var(--accent-purple); margin-bottom: 30px; }
        .highlight-card h3 { color: var(--accent-lime); margin-bottom: 15px; }
        .loading { text-align: center; padding: 50px; font-size: 1.2rem; opacity: 0.5; }

        .boards-container { display: flex; gap: 15px; flex-wrap: wrap; margin-top: 15px; }
        .board-btn { display: inline-block; background: var(--accent-lime); color: var(--bg-color); padding: 15px 25px; border-radius: 12px; text-decoration: none; font-weight: 800; font-size: 1rem; transition: 0.3s; border: none; cursor: pointer; text-align: center; }
        .board-btn:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(197, 240, 90, 0.3); }
        .notebook-btn { background: var(--accent-purple); color: white; }
        .game-btn { background: #f4f3ee; color: var(--bg-color); }

        /* Модалка выбора аватарки */
        .avatar-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); justify-content: center; align-items: center; z-index: 2000; backdrop-filter: blur(5px); }
        .avatar-modal.active { display: flex; }
        .avatar-modal-content { background: var(--bg-color); padding: 30px; border-radius: 24px; max-width: 500px; width: 90%; text-align: center; border: 1px solid rgba(255,255,255,0.1); }
        .avatar-modal-content h2 { margin-bottom: 20px; color: var(--accent-lime); }
        .avatar-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 20px; }
        .avatar-option { background: var(--card-bg); border-radius: 15px; padding: 10px; cursor: pointer; border: 2px solid transparent; transition: 0.2s; }
        .avatar-option:hover { border-color: var(--accent-purple); transform: scale(1.05); }
        .avatar-option.selected { border-color: var(--accent-lime); }
        .avatar-option svg { width: 100%; height: auto; }
        .close-avatar-btn { background: transparent; color: #ff6b6b; border: none; font-size: 1rem; cursor: pointer; padding: 10px; }

        .chat-fab { position: fixed; bottom: 30px; right: 30px; width: 60px; height: 60px; background: var(--accent-lime); border-radius: 50%; display: flex; justify-content: center; align-items: center; box-shadow: 0 10px 25px rgba(197, 240, 90, 0.4); z-index: 1000; text-decoration: none; font-size: 1.8rem; transition: 0.3s; }
        .chat-fab:hover { transform: scale(1.1); }
        .chat-fab-badge { position: absolute; top: 0; right: 0; background: var(--danger); color: white; font-size: 0.8rem; font-weight: bold; padding: 4px 8px; border-radius: 50%; border: 2px solid var(--bg-color); display: none; }

        @media (max-width: 768px) {
            .profile-header { flex-direction: column; text-align: center; padding: 30px 20px; }
            .info-grid { grid-template-columns: 1fr; }
            .header-right span { display: none; }
            .boards-container { justify-content: center; }
            .avatar-grid { grid-template-columns: repeat(3, 1fr); }
        }
    </style>
</head>
<body>
    <header>
        <a href="index.html" class="logo-container"><img src="logo.png" alt="Logo"></a>
        <div class="header-right">
            <span id="header-name">Загрузка...</span>
            <a href="#" onclick="supabaseClient.auth.signOut().then(() => window.location.href = 'login.html')" class="btn-logout">Выйти</a>
        </div>
    </header>

    <div class="container" id="main-content">
        <div class="loading">Загрузка профиля...</div>
    </div>

    <!-- Модалка выбора аватарки -->
    <div class="avatar-modal" id="avatarModal">
        <div class="avatar-modal-content">
            <h2>Выбери свой аватар</h2>
            <div class="avatar-grid" id="avatarGrid"></div>
            <button class="close-avatar-btn" id="closeAvatarModal">Отмена</button>
        </div>
    </div>

    <!-- Плавающая кнопка чата -->
    <a href="chat.html" class="chat-fab" id="chat-fab">
        💬
        <span class="chat-fab-badge" id="chat-fab-badge">0</span>
    </a>

    <script>
        const SUPABASE_URL = 'https://kajvldevytbrkeomwlms.supabase.co';
        const SUPABASE_KEY = 'sb_publishable__PdBbe6y-EKJ0z4DfPrKKQ_ru9yogqW';
        const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        // --- SVG Аватарки ---
        const avatars = {
            'cat': `<svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#c5f05a"/><path d="M30 40 L20 20 L40 30 Z" fill="#25283d"/><path d="M70 40 L80 20 L60 30 Z" fill="#25283d"/><circle cx="50" cy="55" r="30" fill="#25283d"/><circle cx="35" cy="50" r="5" fill="#c5f05a"/><circle cx="65" cy="50" r="5" fill="#c5f05a"/><path d="M45 65 Q50 70 55 65" stroke="#c5f05a" stroke-width="3" fill="none"/></svg>`,
            'dog': `<svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#7455d9"/><ellipse cx="30" cy="40" rx="10" ry="20" fill="#25283d"/><ellipse cx="70" cy="40" rx="10" ry="20" fill="#25283d"/><circle cx="50" cy="55" r="30" fill="#25283d"/><circle cx="40" cy="50" r="5" fill="white"/><circle cx="60" cy="50" r="5" fill="white"/><ellipse cx="50" cy="65" rx="8" ry="5" fill="white"/></svg>`,
            'fox': `<svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#ff6b6b"/><path d="M20 50 L10 15 L35 35 Z" fill="#25283d"/><path d="M80 50 L90 15 L65 35 Z" fill="#25283d"/><circle cx="50" cy="55" r="30" fill="#25283d"/><path d="M40 60 L50 70 L60 60" stroke="white" stroke-width="3" fill="none"/></svg>`,
            'robot': `<svg viewBox="0 0 100 100"><rect x="0" y="0" width="100" height="100" fill="#313452"/><rect x="25" y="30" width="50" height="40" rx="10" fill="#c5f05a"/><circle cx="40" cy="45" r="5" fill="#25283d"/><circle cx="60" cy="45" r="5" fill="#25283d"/><rect x="40" y="55" width="20" height="5" fill="#25283d"/><line x1="50" y1="15" x2="50" y2="30" stroke="white" stroke-width="3"/><circle cx="50" cy="12" r="4" fill="white"/></svg>`,
            'alien': `<svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#c5f05a"/><ellipse cx="50" cy="50" rx="30" ry="40" fill="#25283d"/><ellipse cx="35" cy="45" rx="8" ry="15" fill="white" transform="rotate(-20 35 45)"/><ellipse cx="65" cy="45" rx="8" ry="15" fill="white" transform="rotate(20 65 45)"/></svg>`,
            'bear': `<svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#7455d9"/><circle cx="25" cy="25" r="15" fill="#25283d"/><circle cx="75" cy="25" r="15" fill="#25283d"/><circle cx="50" cy="55" r="35" fill="#25283d"/><circle cx="40" cy="50" r="5" fill="white"/><circle cx="60" cy="50" r="5" fill="white"/><circle cx="50" cy="65" r="10" fill="white"/><circle cx="50" cy="65" r="5" fill="#25283d"/></svg>`,
            'owl': `<svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#f4f3ee"/><circle cx="50" cy="55" r="35" fill="#25283d"/><circle cx="35" cy="45" r="12" fill="white"/><circle cx="65" cy="45" r="12" fill="white"/><circle cx="35" cy="45" r="5" fill="#25283d"/><circle cx="65" cy="45" r="5" fill="#25283d"/><path d="M45 65 L50 75 L55 65 Z" fill="#c5f05a"/></svg>`,
            'hero': `<svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="50" fill="#ff6b6b"/><circle cx="50" cy="40" r="20" fill="#25283d"/><path d="M20 100 Q20 70 50 70 Q80 70 80 100" fill="#25283d"/><path d="M30 40 Q50 20 70 40" stroke="#c5f05a" stroke-width="5" fill="none"/><circle cx="50" cy="40" r="5" fill="white"/></svg>`
        };

        let currentUser = null;
        let userData = null;

        async function loadProfile() {
            const { data: { user }, error: authError } = await supabaseClient.auth.getUser();
            
            if (authError || !user) {
                window.location.href = 'login.html';
                return;
            }
            currentUser = user;

            const { data, error } = await supabaseClient.from('students').select('*').eq('id', user.id).single();

            if (error || !data) {
                document.getElementById('main-content').innerHTML = '<div class="loading" style="color:red;">Профиль ученика не найден. Обратитесь к преподавателю.</div>';
                return;
            }
            userData = data;
            renderProfile(data);
            loadUnreadCount(user.id);
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            
            document.getElementById(`tab-btn-${tabId}`).classList.add('active');
            document.getElementById(`tab-content-${tabId}`).classList.add('active');
        }

        function createList(text) {
            if (!text || text.trim() === '') return '<li>Пока нет данных</li>';
            return text.split('\n').filter(t => t.trim() !== '').map(t => `<li>${t}</li>`).join('');
        }

        function renderStudentCalendar(month, year, scheduleStr) {
            if (!month || !year) return '<p style="opacity:0.5;">Расписание еще не составлено.</p>';
            
            const m = parseInt(month);
            const y = parseInt(year);
            const months = ['Январь', 'Февраль', 'Март', 'Апрель', 'Май', 'Июнь', 'Июль', 'Август', 'Сентябрь', 'Октябрь', 'Ноябрь', 'Декабрь'];
            
            const daysObj = {};
            if (scheduleStr) {
                scheduleStr.split(',').forEach(item => {
                    const [day, time] = item.split('=');
                    if (day) daysObj[day] = time || '';
                });
            }
            
            const firstDay = new Date(y, m, 1).getDay();
            const daysInMonth = new Date(y, m + 1, 0).getDate();
            let startOffset = firstDay === 0 ? 6 : firstDay - 1; 
            
            let html = `<div class="cal-month-title">${months[m]} ${y}</div>`;
            html += `<div class="calendar-student">`;
            
            ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'].forEach(d => html += `<div class="cal-header-st">${d}</div>`);
            for (let i = 0; i < startOffset; i++) html += `<div></div>`;

            for (let day = 1; day <= daysInMonth; day++) {
                const time = daysObj[day];
                const isLesson = time !== undefined;
                html += `<div class="cal-day-st ${isLesson ? 'lesson-day' : ''}">
                    ${day}
                    ${isLesson && time ? `<span class="cal-time-st">${time}</span>` : ''}
                </div>`;
            }
            
            html += `</div>`;
            return html;
        }

        function renderProfile(s) {
            document.getElementById('header-name').innerText = `Ученик: ${s.name}`;
            const main = document.getElementById('main-content');
            const level = parseInt(s.level) || 0;
            
            let subs = (s.subjects || '').split(',').map(x=>x.trim()).filter(x=>x);
            let subsHtml = subs.length > 0 ? subs.map(sub => `<span class="subject-tag">${sub}</span>`).join('') : '<span class="subject-tag">Предмет не указан</span>';

            let boardsButtons = '';
            if (subs.length > 0) {
                boardsButtons = subs.map(sub => `
                    <a href="board.html?subject=${encodeURIComponent(sub)}&role=student" target="_blank" class="board-btn">
                        Доска: ${sub}
                    </a>
                `).join('');
            } else {
                boardsButtons = '<p style="opacity:0.5; width: 100%;">Предметы не указаны, доступ к доскам закрыт.</p>';
            }

            const currentAvatar = s.avatar_id && avatars[s.avatar_id] ? avatars[s.avatar_id] : avatars['cat'];

            main.innerHTML = `
                <div class="tabs-nav">
                    <button class="tab-btn active" id="tab-btn-profile" onclick="switchTab('profile')">Профиль</button>
                    <button class="tab-btn" id="tab-btn-success" onclick="switchTab('success')">Успехи</button>
                    <button class="tab-btn" id="tab-btn-tools" onclick="switchTab('tools')">Инструменты</button>
                </div>

                <!-- ВКЛАДКА ПРОФИЛЬ -->
                <div class="tab-content active" id="tab-content-profile">
                    <div class="profile-header">
                        <div class="avatar-container">
                            <div class="avatar-img" id="current-avatar-display">${currentAvatar}</div>
                            <button class="avatar-edit-btn" id="editAvatarBtn">✏️</button>
                        </div>
                        <div class="profile-info">
                            <h1>${s.surname} ${s.name}</h1>
                            <p>Возраст: ${s.age || '?'} лет • ${s.grade || '?'} класс</p>
                            <div class="tags-container">${subsHtml}</div>
                        </div>
                    </div>

                    <div class="info-grid">
                        <div class="info-card">
                            <h3>Уровень знаний</h3>
                            <p style="font-size: 2rem; font-weight: 800; color: white; margin-bottom: 10px;">${level} / 5</p>
                            <div class="level-bar-container">
                                <div class="level-bar-fill" style="width: ${(level / 5) * 100}%;">${level > 0 ? level * 20 + '%' : ''}</div>
                            </div>
                            <p style="margin-top: 15px; opacity: 0.7; font-size: 0.9rem;">Прогресс обновляется куратором.</p>
                        </div>
                        <div class="info-card">
                            <h3>Расписание занятий</h3>
                            ${renderStudentCalendar(s.schedule_month, s.schedule_year, s.schedule_days)}
                        </div>
                    </div>
                </div>

                <!-- ВКЛАДКА УСПЕХИ -->
                <div class="tab-content" id="tab-content-success">
                    <div class="info-grid">
                        <div class="info-card">
                            <h3>Результаты тестирований</h3>
                            <ul class="custom-list tests-list">${createList(s.tests)}</ul>
                        </div>
                    </div>

                    <div class="highlight-card">
                        <h3>Пройденные темы</h3>
                        <ul class="custom-list topics-list">${createList(s.topics)}</ul>
                    </div>

                    <div class="highlight-card">
                        <h3>ИОМ (Индивидуальный образовательный маршрут)</h3>
                        <ul class="custom-list iom-list">${createList(s.iom)}</ul>
                    </div>
                </div>

                <!-- ВКЛАДКА ИНСТРУМЕНТЫ -->
                <div class="tab-content" id="tab-content-tools">
                    <div class="info-card" style="margin-bottom: 25px;">
                        <h3>Интерактивные доски</h3>
                        <p style="opacity:0.7; margin-bottom: 15px; font-size: 0.9rem;">Нажмите на кнопку, чтобы открыть доску по предмету.</p>
                        <div class="boards-container">
                            ${boardsButtons}
                        </div>
                    </div>

                    <div class="info-card">
                        <h3>Дополнительно</h3>
                        <div class="boards-container" style="margin-top: 0;">
                            <a href="notebook.html?student_id=${s.id}&role=student&name=${encodeURIComponent(s.surname + ' ' + s.name)}" target="_blank" class="board-btn notebook-btn">
                                📓 Моя тетрадь
                            </a>
                            <a href="game.html" class="board-btn game-btn">
                                🎮 Перерыв (Игра)
                            </a>
                        </div>
                    </div>
                </div>
            `;

            // Инициализация модалки аватарки
            setupAvatarModal();
        }

        function setupAvatarModal() {
            const modal = document.getElementById('avatarModal');
            const grid = document.getElementById('avatarGrid');
            const editBtn = document.getElementById('editAvatarBtn');
            const closeBtn = document.getElementById('closeAvatarModal');
            
            grid.innerHTML = '';
            Object.keys(avatars).forEach(key => {
                const div = document.createElement('div');
                div.className = 'avatar-option';
                if (userData.avatar_id === key) div.classList.add('selected');
                div.innerHTML = avatars[key];
                div.onclick = () => selectAvatar(key, div);
                grid.appendChild(div);
            });

            editBtn.onclick = () => modal.classList.add('active');
            closeBtn.onclick = () => modal.classList.remove('active');
            modal.onclick = (e) => { if (e.target === modal) modal.classList.remove('active'); };
        }

        async function selectAvatar(avatarKey, el) {
            const originalContent = el.innerHTML;
            el.innerHTML = '<div style="color:white; font-size:0.8rem; height:100%; display:flex; align-items:center; justify-content:center;">Сохр...</div>';
            
            const { error } = await supabaseClient.from('students').update({ avatar_id: avatarKey }).eq('id', currentUser.id);
            
            if (error) {
                alert('Ошибка сохранения аватарки');
                el.innerHTML = originalContent;
                return;
            }

            userData.avatar_id = avatarKey;
            document.getElementById('current-avatar-display').innerHTML = avatars[avatarKey];
            
            document.querySelectorAll('.avatar-option').forEach(opt => opt.classList.remove('selected'));
            el.classList.add('selected');
            
            setTimeout(() => {
                document.getElementById('avatarModal').classList.remove('active');
            }, 300);
        }

        async function loadUnreadCount(userId) {
            const { data: myChats } = await supabaseClient.from('chat_participants').select('chat_id').eq('user_id', userId);
            if (!myChats || myChats.length === 0) return;
            const chatIds = myChats.map(c => c.chat_id);
            const { count, error } = await supabaseClient.from('messages').select('*', { count: 'exact', head: true }).in('chat_id', chatIds).eq('is_read', false).neq('sender_id', userId);
            if (!error && count > 0) {
                const badge = document.getElementById('chat-fab-badge');
                badge.innerText = count;
                badge.style.display = 'block';
            }
        }

        loadProfile();
    </script>
</body>
</html>